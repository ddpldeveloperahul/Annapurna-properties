DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=*

# Set to "postgres" for staging/production (see docker-compose.yml).
# Defaults to a local SQLite file so the project runs with zero setup.
DATABASE_ENGINE=sqlite
POSTGRES_DB=anpurna_properties
POSTGRES_USER=anpurna_properties
POSTGRES_PASSWORD=anpurna_properties
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
# true = tasks run synchronously in-process (no Redis/worker needed) — good
# for quick local review. Set false once you're running `celery worker`.
CELERY_TASK_ALWAYS_EAGER=true

# Keep true until you have real provider accounts. All integrations return
# realistic mock responses when this is true, so the whole call -> lead ->
# summary -> WhatsApp pipeline works with zero external credentials.
AI_CALLING_MOCK_PROVIDERS=true

EXOTEL_SID=
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_CALLER_ID=
EXOTEL_WEBHOOK_SECRET=

ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=

LLM_PROVIDER=openai
OPENAI_API_KEY=
LLM_MODEL=gpt-5.6-luna
LLM_API_BASE_URL=https://api.openai.com/v1

WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=dev-verify-token
WHATSAPP_TEMPLATE_NAME=enquiry_ack_v1
WHATSAPP_TEMPLATE_LANG=hi

# Production realtime/provider settings
EXOTEL_API_BASE_URL=https://api.in.exotel.com
EXOTEL_STREAM_URL=wss://api.example.com/ws/telephony/exotel/stream/?sample-rate=16000
EXOTEL_STATUS_CALLBACK_URL=https://api.example.com/api/v1/telephony/webhooks/call-status/
EXOTEL_STREAM_SAMPLE_RATE=16000
ELEVENLABS_API_BASE_URL=https://api.elevenlabs.io
ELEVENLABS_WS_BASE_URL=wss://api.elevenlabs.io
WHATSAPP_APP_SECRET=
WHATSAPP_GRAPH_VERSION=v23.0
PROVIDER_HTTP_TIMEOUT_SECONDS=15
